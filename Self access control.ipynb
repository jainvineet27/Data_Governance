   "source": [
    "create or replace function namaste_catalog.vineetdb.state_permission ( state String)\n",
    "return  case when current_user() = \"abc@vineetanythinggmail.onmicrosoft.com\"  then state in (\"Assam\",\"Goa\")\n",
    "else TRUE end ; \n"
   ]
  },

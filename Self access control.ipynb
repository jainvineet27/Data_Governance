   "outputs": [],
   "source": [
    "create or replace function column_masking (customer_id int)\n",
    "return \n",
    "case when current_user() = \"abc@vineetanythinggmail.onmicrosoft.com\"  then \"100001\"\n",
    "else customer_id end"
   ]
